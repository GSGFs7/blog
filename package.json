{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ssr": "vite build --ssr && node scripts/build_ssr_assets.mjs",
    "build:all": "pnpm run build && pnpm run build:ssr && uv run manage.py collectstatic --noinput",
    "preview": "vite preview",
    "analyze": "ANALYZE=1 pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:ui": "vitest --project browser --browser.headless=false",
    "test:e2e": "E2E_SUITE=base playwright test",
    "test:e2e:htmx": "E2E_SUITE=htmx playwright test",
    "test:e2e:native": "E2E_SUITE=native playwright test",
    "test:e2e:base:htmx": "E2E_SUITE=base E2E_NAVIGATION_MODE=htmx playwright test",
    "test:e2e:base:native": "E2E_SUITE=base E2E_NAVIGATION_MODE=native playwright test",
    "test:e2e:ui": "E2E_SUITE=base playwright test --ui",
    "test:ssr": "pnpm run build:ssr && uv run manage.py test web.tests.test_solid_islands && E2E_SUITE=ssr playwright test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "postinstall": "node scripts/copy-katex.mjs"
  },
  "dependencies": {
    "@fontsource/maple-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fast-string-width": "^3.0.2",
    "htmx-ext-head-support": "^2.0.5",
    "htmx-ext-preload": "^2.1.2",
    "htmx.org": "^2.0.10",
    "lxgw-wenkai-screen-web": "^1.522.0",
    "mathjs": "^15.2.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.75.0",
    "sonda": "^0.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "packageManager": "pnpm@11.3.0"
}
