        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (job, metrics_path) (up{job=\"k3s-server\", metrics_path=~\"/metrics|/metrics/cadvisor|/metrics/probes\"})",
          "legendFormat": "{{job}} {{metrics_path}}",
          "datasource": {
