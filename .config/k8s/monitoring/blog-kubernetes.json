{
  "uid": "blog-kubernetes",
  "title": "Blog / Containers and Kubernetes",
  "description": "Blog container capacity, restarts, probes, and autoscaling metrics from Rancher Monitoring. Application request, database, and cache metrics are available in the Blog / Django dashboard.",
  "tags": [
    "blog",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Blog alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{namespace=\"blog\", service=\"blog\", alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{pod}} {{container}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_container_info{namespace=\"blog\"}, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_container_info{namespace=\"blog\", pod=~\"$pod\"}, container)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Django available / desired replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Covers the entire Django Deployment. Pod and Container filters do not apply.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_deployment_status_replicas_available{namespace=\"blog\", deployment=\"blog-django\"})",
          "legendFormat": "Available",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max(kube_deployment_spec_replicas{namespace=\"blog\", deployment=\"blog-django\"})",
          "legendFormat": "Desired",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Restarts in the last 10 minutes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Counter increase is extrapolated and may contain fractional values. The first restart of a new pod may be missed if no baseline sample exists.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (namespace, pod, container, uid) (increase(kube_pod_container_status_restarts_total{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\"}[10m])))",
          "legendFormat": "Restarts",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Containers restarted after OOM in the last 10 minutes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Counts recently restarted containers whose last termination reason is OOMKilled, rather than total OOM events. Interpret alongside scrape target health.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((max by (namespace, pod, container, uid) (increase(kube_pod_container_status_restarts_total{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\"}[10m])) > 0) and on (namespace, pod, container, uid) (max by (namespace, pod, container, uid) (kube_pod_container_status_last_terminated_reason{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", reason=\"OOMKilled\"}) == 1)) or vector(0)",
          "legendFormat": "OOM containers",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Firing Blog alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Covers dedicated alerts for the entire blog namespace. Pod and Container filters do not apply.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{namespace=\"blog\", service=\"blog\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Alerts",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Container CPU usage and limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", container!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} / {{container}} usage",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", resource=\"cpu\", unit=\"core\"})",
          "legendFormat": "{{pod}} / {{container}} limit",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU throttled periods ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction of CPU scheduling periods that were throttled, not the fraction of CPU time lost. Alert threshold: above 25% for 3 minutes.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", container!=\"\", image!=\"\"}[5m])) / (max by (namespace, pod, container) (rate(container_cpu_cfs_periods_total{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", container!=\"\", image!=\"\"}[5m])) > 0)",
          "legendFormat": "{{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Container memory working set and limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", container!=\"\", image!=\"\"})",
          "legendFormat": "{{pod}} / {{container}} working set",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", resource=\"memory\", unit=\"byte\"})",
          "legendFormat": "{{pod}} / {{container}} limit",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Memory usage / limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Alert threshold: above 85% for 3 minutes. Containers without a memory limit are excluded.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", container!=\"\", image!=\"\"}) / on (namespace, pod, container) (max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", resource=\"memory\", unit=\"byte\"}) > 0)",
          "legendFormat": "{{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "title": "Container restarts in the last 10 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container, uid) (increase(kube_pod_container_status_restarts_total{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\"}[10m]))",
          "legendFormat": "{{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "title": "Container readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "1 means ready; 0 means not ready. Missing data does not indicate a healthy container.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container) (kube_pod_container_status_ready{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\"})",
          "legendFormat": "{{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "title": "Probe failures in the last 5 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "From kubelet /metrics/probes. Missing data may indicate no failure samples, unconfigured probes, or a scrape problem.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container, probe_type) (increase(prober_probe_total{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\", result=\"failed\"}[5m]))",
          "legendFormat": "{{pod}} / {{container}} {{probe_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "title": "HPA current / desired / maximum replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Covers the entire blog namespace. Pod and Container filters do not apply. Workloads without an HPA are excluded.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_current_replicas{namespace=\"blog\"})",
          "legendFormat": "{{horizontalpodautoscaler}} current",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (namespace, horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"blog\"})",
          "legendFormat": "{{horizontalpodautoscaler}} desired",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "max by (namespace, horizontalpodautoscaler) (kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"blog\"})",
          "legendFormat": "{{horizontalpodautoscaler}} maximum",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 13,
      "title": "Last termination reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Shows the last termination reason. An old reason may persist and does not indicate an ongoing failure.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, container, reason) (kube_pod_container_status_last_terminated_reason{namespace=\"blog\", pod=~\"$pod\", container=~\"$container\"}) == 1",
          "legendFormat": "{{pod}} / {{container}} {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 14,
      "title": "Infrastructure scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "1 means scrape success; 0 means scrape failure. A missing target produces no data. Covers the entire cluster; Pod and Container filters do not apply.",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
