{
  "uid": "blog-django",
  "title": "Blog / Django",
  "description": "Django request, database, and cache metrics. Requires per-Pod Gunicorn multiprocess aggregation and the blog-django ServiceMonitor. Request panels exclude health checks and metrics scrapes; database/cache panels cover selected Pods independently of View.",
  "tags": ["blog", "django"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Blog alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{namespace=\"blog\", service=\"blog\", alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{pod}} {{container}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{namespace=\"blog\", service=\"blog-django\"}, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "view",
        "label": "View",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(django_http_responses_total_by_status_view_method_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view!~\"api:heath_status|prometheus-django-metrics\"}, view)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Excludes health checks (api:heath_status) and Prometheus scrapes. Pod and View filters apply. Latency is measured by the view/method histogram and does not include all middleware processing.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(django_http_responses_total_by_status_view_method_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval]))",
          "legendFormat": "Requests",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx response ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "No traffic produces no ratio. Excludes health checks (api:heath_status) and Prometheus scrapes. Pod and View filters apply. Latency is measured by the view/method histogram and does not include all middleware processing.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(django_http_responses_total_by_status_view_method_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\", status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(django_http_responses_total_by_status_view_method_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval])))) / (sum(rate(django_http_responses_total_by_status_view_method_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency P95",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Excludes health checks (api:heath_status) and Prometheus scrapes. Pod and View filters apply. Latency is measured by the view/method histogram and does not include all middleware processing.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Scrape targets up / discovered",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Counts discovered Django targets. The View filter does not apply; compare with desired replicas on the Kubernetes dashboard to detect missing targets.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"})",
          "legendFormat": "Up",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "count(up{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"})",
          "legendFormat": "Discovered",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Request rate by view",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Excludes health checks (api:heath_status) and Prometheus scrapes. Pod and View filters apply. Latency is measured by the view/method histogram and does not include all middleware processing.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (view) (rate(django_http_responses_total_by_status_view_method_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval]))",
          "legendFormat": "{{view}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Responses by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Excludes health checks (api:heath_status) and Prometheus scrapes. Pod and View filters apply. Latency is measured by the view/method histogram and does not include all middleware processing.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(django_http_responses_total_by_status_view_method_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Request latency P50 / P95 / P99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Excludes health checks (api:heath_status) and Prometheus scrapes. Pod and View filters apply. Latency is measured by the view/method histogram and does not include all middleware processing.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Slowest views by P95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Excludes health checks (api:heath_status) and Prometheus scrapes. Pod and View filters apply. Latency is measured by the view/method histogram and does not include all middleware processing. Shows the top ten view/method combinations at each evaluation.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, view, method) (rate(django_http_requests_latency_seconds_by_view_method_bucket{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\", view=~\"$view\", view!~\"api:heath_status|prometheus-django-metrics\"}[$__rate_interval]))))",
          "legendFormat": "{{view}} {{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "title": "Database statement rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Django-side database instrumentation for selected Pods; not PostgreSQL server metrics or Celery queries. The View filter does not apply.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alias) (rate(django_db_execute_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{alias}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "title": "Database query latency P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Django-side database instrumentation for selected Pods; not PostgreSQL server metrics or Celery queries. The View filter does not apply.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, alias) (rate(django_db_query_duration_seconds_bucket{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{alias}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "title": "Database connections and errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Django-side database instrumentation for selected Pods; not PostgreSQL server metrics or Celery queries. The View filter does not apply. Missing error series can mean no such errors have been observed.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alias) (rate(django_db_new_connections_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{alias}} new connections",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (alias) (rate(django_db_new_connection_errors_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{alias}} connection errors",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum by (alias, type) (rate(django_db_errors_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{alias}} {{type}} query errors",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "title": "Cache get outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Instrumented Django cache get operations, aggregated by backend across cache aliases. Does not cover all Redis activity. The View filter does not apply.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend) (rate(django_cache_get_hits_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} hits",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (backend) (rate(django_cache_get_misses_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} misses",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum by (backend) (rate(django_cache_get_fail_total{namespace=\"blog\", service=\"blog-django\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} failures",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 13,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Instrumented Django cache get operations, aggregated by backend across cache aliases. Does not cover all Redis activity. The View filter does not apply. Hits divided by hits plus misses; no lookups produces no ratio.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
