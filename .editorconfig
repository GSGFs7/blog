root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
tab_width = 4

[*.html]
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2

[{*.json,*.jsonc}]
indent_size = 2

[{*.tsx,*.mts,*.ts,*.js,*.jsx,*.mjs,*.cjs}]
indent_size = 2

[*.css]
indent_size = 2
