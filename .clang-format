---
# Validated with clang-format 22.1.8.
Language: C
BasedOnStyle: LLVM

# PEP 7: four-space indentation, no tabs, and a maximum line length of 79.
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 79

# PEP 7 keeps control-statement braces on the same line, puts braces for
# multiline conditions on their own line, and starts function definitions at
# the left margin.
BreakBeforeBraces: Custom
AlwaysBreakAfterDefinitionReturnType: All
BraceWrapping:
  AfterControlStatement: MultiLine
  AfterFunction: true
  BeforeElse: true
IndentCaseLabels: true

# Break long argument lists after commas and align continuation lines with the
# first argument, as shown in PEP 7.
AlignAfterOpenBracket: Align
AlignOperands: DontAlign
BinPackArguments: true
BinPackParameters: BinPack
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# Avoid visually aligned whitespace that changes unrelated lines.
AlignConsecutiveAssignments: false
AlignTrailingComments: false
SpacesBeforeTrailingComments: 1

# Keep function and block braces on separate lines, including empty bodies.
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
Cpp11BracedListStyle: true

# Keep idiomatic C pointer declarations and avoid splitting off return types.
DerivePointerAlignment: false
PointerAlignment: Right
PenaltyReturnTypeOnItsOwnLine: 1000

KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SortIncludes: CaseSensitive
...
